# Copy to .env for local use. Never commit real values.
PORT=3000
PUBLIC_BASE_URL=
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL=600
HEALTH_CHECK_INTERVAL=30
MONITORING_ENABLED=true
RECONNECT_ENABLED=true
RECONNECT_INITIAL_DELAY=15
RECONNECT_MAX_DELAY=300
RECONNECT_JITTER=0.2
RECONNECT_STABLE_SECONDS=300
MAX_RESTART_ATTEMPTS=0
SESSION_SAVE_INTERVAL=1800
MEMORY_WARNING_MB=512
MEMORY_RESTART_MB=1024
MEMORY_RESTART_COOLDOWN=1800
MEMORY_CONFIRM_CHECKS=3
LISTENER_SILENCE_WARN=3600
BOT_ADMIN_TOKEN=
# DOUNYA COOKIE MANAGER
COOKIE_PANEL_PASSWORD=
COOKIE_ENCRYPTION_KEY=
# Supabase (auto-provisioned on Railway — do not hardcode)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
